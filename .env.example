# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma separated, or * to allow all (dev only)
CORS_ORIGINS=*

# ---- Database ----
DATABASE_URL=postgresql://swasth:swasth@localhost:5432/swasth?schema=public

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only: returns the OTP in the API response instead of sending an SMS.
# Rejected at boot if NODE_ENV is staging or production.
OTP_DEV_MODE=true
# Optional fixed code for local testing, e.g. 123456
OTP_DEV_CODE=

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
