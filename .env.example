# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma separated, or * to allow all (dev only)
CORS_ORIGINS=*

# ---- Database ----
DATABASE_URL=postgresql://swasth:swasth@localhost:5432/swasth?schema=public

# ---- JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=30d

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only: returns the OTP in the API response instead of sending an SMS.
# Rejected at boot if NODE_ENV is staging or production.
OTP_DEV_MODE=true
# Optional fixed code for local testing - keeps the OTP predictable
OTP_DEV_CODE=123456

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---- Telemetry (Grafana Cloud) ----
# Optional. Leave OTEL_EXPORTER_OTLP_ENDPOINT blank and nothing is exported —
# no exporters start, no background timers run, and the API behaves exactly as
# it did before telemetry existed.
#
# To fill these in: Grafana Cloud portal -> your stack -> the OpenTelemetry
# tile -> Configure. It hands you the endpoint and a base64 token in one block.
# <REGION> is whatever your stack sits in, e.g. prod-eu-west-2.
OTEL_EXPORTER_OTLP_ENDPOINT=
# The whole header, exactly as Grafana gives it, e.g.
# Authorization=Basic%20<base64 of instanceID:token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=swasth-api
# Prints exporter failures to stdout. Worth turning on the first time you wire
# this up — a wrong token otherwise fails silently and the dashboards just
# stay empty with no clue why.
OTEL_DIAG_LOG=false
