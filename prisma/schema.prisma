// Swasth backend - Prisma schema
//
// Tenancy: one database, many gyms. Every gym-owned row carries gymId.
// Identity: a person (User) is global and unique by phone; their relationship
// with a gym - role, member code, status - lives on GymUser. The same phone can
// therefore be a member at one gym and a trainer at another.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GymRole {
  MEMBER
  TRAINER
  GYM_ADMIN
  OWNER
}

enum GymUserStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum MemberSource {
  APP_SIGNUP
  FRONT_DESK
  IMPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  GENERAL_FITNESS
  ENDURANCE
  REHAB
}

enum ActivityLevel {
  BEGINNER
  OCCASIONAL
  REGULAR
}

enum OtpPurpose {
  LOGIN
  PHONE_UPDATE
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum DurationUnit {
  DAY
  MONTH
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

/// The parts of the body a session covered. CARDIO and FULL_BODY are not
/// muscles, but they are how members describe a day that wasn't split.
enum MuscleGroup {
  CHEST
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  TRAPS
  LATS
  LOWER_BACK
  GLUTES
  QUADS
  HAMSTRINGS
  CALVES
  CARDIO
  FULL_BODY
}

enum CheckInSource {
  /// Member tapped "Check in" in the app.
  APP
  /// Staff recorded it for them at the desk.
  FRONT_DESK
}

/// A single gym. Onboarding a new gym is one row here - there is no self-serve
/// signup; the platform admin creates it.
model Gym {
  id        String  @id @default(uuid()) @db.Uuid
  /// Stable slug the mobile app is built against, e.g. "swasth-koramangala".
  code      String  @unique @db.VarChar(60)
  name      String  @db.VarChar(120)
  legalName String? @db.VarChar(160)

  phone String  @db.VarChar(20)
  email String? @db.VarChar(255)

  addressLine1 String?  @db.VarChar(200)
  addressLine2 String?  @db.VarChar(200)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  pincode      String?  @db.VarChar(12)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  logoUrl  String @default("") @db.VarChar(500)
  timezone String @default("Asia/Kolkata") @db.VarChar(60)
  currency String @default("INR") @db.VarChar(3)

  /// Member codes are issued as <prefix><padded counter>, e.g. SWK-0007.
  memberCodePrefix String @default("M") @db.VarChar(10)
  memberSeq        Int    @default(0)

  isActive    Boolean   @default(true)
  onboardedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  gymUsers      GymUser[]
  refreshTokens RefreshToken[]
  plans         Plan[]
  subscriptions Subscription[]
  checkIns      CheckIn[]
  workouts      Workout[]

  @@index([isActive])
  @@map("gyms")
}

/// A person. Global across gyms - phone is unique system-wide.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  /// E.164 format, e.g. +919876543210
  phone         String    @unique @db.VarChar(20)
  phoneVerified Boolean   @default(false)
  email         String?   @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  fullName      String?   @db.VarChar(120)
  gender        Gender    @default(UNDISCLOSED)
  dateOfBirth   DateTime? @db.Date
  heightCm      Decimal?  @db.Decimal(5, 2)
  weightKg      Decimal?  @db.Decimal(5, 2)
  avatarUrl     String?   @db.VarChar(500)
  city          String?   @db.VarChar(100)

  /// Reserved for the Swasth team - can onboard gyms. Not a gym-level role.
  isPlatformAdmin Boolean @default(false)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  gymUsers      GymUser[]
  otpRequests   OtpRequest[]
  refreshTokens RefreshToken[]
  devices       Device[]

  @@index([createdAt])
  @@map("users")
}

/// One person's relationship with one gym. This is the row that says "Rohit is
/// an active member of Swasth Koramangala, code SWK-0007".
model GymUser {
  id     String @id @default(uuid()) @db.Uuid
  gymId  String @db.Uuid
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       GymRole       @default(MEMBER)
  status     GymUserStatus @default(ACTIVE)
  /// Human-facing id used at the front desk. Members only; null for staff.
  memberCode String?       @db.VarChar(30)
  source     MemberSource  @default(APP_SIGNUP)

  // Gym-specific member context. Kept here rather than on User so a person can
  // hold a different goal (and a different trainer's notes) at each gym.
  goal          FitnessGoal?
  activityLevel ActivityLevel?
  medicalNotes  String?        @db.VarChar(1000)
  notes         String?        @db.VarChar(1000)

  emergencyContactName  String? @db.VarChar(120)
  emergencyContactPhone String? @db.VarChar(20)

  /// Set when the member finishes in-app onboarding.
  onboardedAt   DateTime?
  joinedAt      DateTime  @default(now())
  lastVisitAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions     Subscription[] @relation("MemberSubscriptions")
  soldSubscriptions Subscription[] @relation("SoldSubscriptions")
  checkIns          CheckIn[]      @relation("MemberCheckIns")
  recordedCheckIns  CheckIn[]      @relation("RecordedCheckIns")
  workouts          Workout[]      @relation("MemberWorkouts")

  @@unique([gymId, userId])
  @@unique([gymId, memberCode])
  @@index([gymId, role, status])
  @@index([gymId, joinedAt])
  @@map("gym_users")
}

/// Something the gym sells: "3 Months", "Annual", "Day Pass".
model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  gymId       String  @db.Uuid
  gym         Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(80)
  description String? @db.VarChar(500)

  /// "3 MONTH", "1 DAY". Calendar months rather than 30-day blocks, because a
  /// member who joins on the 15th expects to expire on the 15th.
  durationValue Int
  durationUnit  DurationUnit @default(MONTH)

  /// Rupees, not paise. Decimal so it never picks up float error.
  price Decimal @db.Decimal(10, 2)

  /// isActive - can still be sold at the desk.
  /// isPublic - also shown in the member app.
  isActive  Boolean @default(true)
  isPublic  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  subscriptions Subscription[]

  @@unique([gymId, name])
  @@index([gymId, isActive, sortOrder])
  @@map("plans")
}

/// One member's purchase of one plan.
///
/// There is deliberately no stored status column: ACTIVE / UPCOMING / EXPIRED
/// are derived from startDate, endDate and cancelledAt at read time, so nothing
/// goes stale and no nightly job is needed to flip expired rows.
model Subscription {
  id        String  @id @default(uuid()) @db.Uuid
  gymId     String  @db.Uuid
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymUserId String  @db.Uuid
  gymUser   GymUser @relation("MemberSubscriptions", fields: [gymUserId], references: [id], onDelete: Cascade)
  planId    String? @db.Uuid
  plan      Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  /// Copied at purchase so history survives the plan being renamed or deleted.
  planName      String       @db.VarChar(80)
  durationValue Int
  durationUnit  DurationUnit

  /// price is the list price, discount what was taken off, amountPaid what
  /// actually came in - which can be less, for an instalment.
  price         Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(300)
  notes        String?   @db.VarChar(500)

  /// The staff member who sold it.
  soldById String?  @db.Uuid
  soldBy   GymUser? @relation("SoldSubscriptions", fields: [soldById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns CheckIn[]

  @@index([gymId, gymUserId, endDate])
  @@index([gymId, endDate])
  @@map("subscriptions")
}

/// One gym visit.
///
/// There is no QR code and no scanner: the member taps a button in the app and
/// confirms. That makes the record self-reported, so it is a record of intent
/// as much as attendance - see localDate for why one per day is enforced.
model CheckIn {
  id        String  @id @default(uuid()) @db.Uuid
  gymId     String  @db.Uuid
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymUserId String  @db.Uuid
  gymUser   GymUser @relation("MemberCheckIns", fields: [gymUserId], references: [id], onDelete: Cascade)

  /// Which membership the visit counted against, kept for later reporting.
  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// The calendar day **in the gym's own timezone**, not UTC. A 5am visit in
  /// India falls on the previous UTC date, which would silently break streaks
  /// and daily counts. The unique constraint below makes a day the unit of
  /// attendance, so a double tap cannot inflate the numbers.
  localDate   DateTime      @db.Date
  checkedInAt DateTime      @default(now())
  source      CheckInSource @default(APP)

  /// Set when a staff member recorded the visit rather than the member.
  recordedById String?  @db.Uuid
  recordedBy   GymUser? @relation("RecordedCheckIns", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  workout Workout?

  @@unique([gymUserId, localDate])
  @@index([gymId, localDate])
  @@index([gymUserId, localDate(sort: Desc)])
  @@map("check_ins")
}

/// What a member actually trained on a visit.
///
/// Hangs off the check-in rather than standing alone, which gives it the day
/// rules for free: attendance is already one row per member per gym-local day,
/// so a workout is too, and a member cannot log training for a day they were
/// never here.
model Workout {
  id        String  @id @default(uuid()) @db.Uuid
  gymId     String  @db.Uuid
  gym       Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymUserId String  @db.Uuid
  gymUser   GymUser @relation("MemberWorkouts", fields: [gymUserId], references: [id], onDelete: Cascade)

  checkInId String  @unique @db.Uuid
  checkIn   CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  /// Copied from the check-in so history and tallies never need the join. It is
  /// the gym's local day for the same reason the check-in's is.
  localDate DateTime @db.Date

  /// Free to be empty: a member who checked in and logged nothing is a real
  /// state, not a broken row.
  muscleGroups MuscleGroup[]

  /// Mirrors the check-in instant. `endedAt` is set when the member taps
  /// "finish" - there is no check-out, so an abandoned session simply has no
  /// end and therefore no duration, which is honest.
  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId, localDate])
  @@index([gymUserId, localDate(sort: Desc)])
  @@map("workouts")
}

/// One row per OTP challenge. The code itself is stored hashed (argon2).
model OtpRequest {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String     @db.VarChar(20)
  codeHash   String     @db.VarChar(255)
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

/// Rotating refresh tokens. Stored hashed; revoked on rotation, logout or reuse.
/// Scoped to a gym, because a token minted for one gym's app must never be
/// usable against another.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId     String    @db.Uuid
  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  tokenHash String    @db.VarChar(255)
  /// Chain id shared by every token rotated from the same login session.
  familyId  String    @db.Uuid
  deviceId  String?   @db.Uuid
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userAgent String?   @db.VarChar(300)
  ipAddress String?   @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Mobile device registration - used later for push notifications.
model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String?        @db.VarChar(500)
  appVersion String?        @db.VarChar(30)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  refreshTokens RefreshToken[]

  @@unique([userId, pushToken])
  @@index([userId])
  @@map("devices")
}
